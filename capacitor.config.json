{
  "appId": "com.okudum.app",
  "appName": "Okudum",
  "webDir": "www",
  "backgroundColor": "#F7F1E6",
  "android": {
    "backgroundColor": "#F7F1E6"
  },
  "ios": {
    "backgroundColor": "#F7F1E6",
    "contentInset": "never"
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "BackgroundRunner": {
      "label": "com.okudum.app.kontrol",
      "src": "runners/kontrol.js",
      "event": "kontrol",
      "repeat": true,
      "interval": 30,
      "autoStart": true
    }
  }
}
